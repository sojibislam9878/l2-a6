model Warehouse {
  id              String          @id @default(uuid())
  ownerId         String          @map("owner_id")
  name            String
  district        String
  address         String
  licenseNo       String          @unique @map("license_no")
  ratePerKgPerDay Decimal         @map("rate_per_kg_per_day") @db.Decimal(10, 4)
  minBookingDays  Int             @default(7) @map("min_booking_days")
  status          WarehouseStatus @default(PENDING)
  avgRating       Decimal?        @map("avg_rating") @db.Decimal(3, 2)
  reviewCount     Int             @default(0) @map("review_count")
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chambers Chamber[]
  reviews  Review[]

  @@index([district, status, deletedAt])
  @@index([ownerId])
  @@map("warehouses")
}
